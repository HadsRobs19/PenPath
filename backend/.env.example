DB_HOST=localhost
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=postgres
DB_SSLMODE=disable

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=penpath-handwriting
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

ANTHROPIC_API_KEY=your_anthropic_api_key

# CORS Configuration
# Set to true to allow requests from any origin (useful for Docker/Pi development)
CORS_ALLOW_ALL=false
# Or specify additional origins (comma-separated)
# ALLOWED_ORIGINS=http://192.168.1.100:5173,http://mypi.local:5173
